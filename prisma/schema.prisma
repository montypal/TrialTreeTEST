// TrialTree data model
// ---------------------------------------------------------------------------
// The "tree" is a self-referential DecisionNode hierarchy:
//   Prostate Cancer (DISEASE_TYPE)
//     └─ mCRPC (DISEASE_STATE)
//          └─ Second-line therapy (LINE_OF_THERAPY)
//               └─ [Trials attach here, each with per-location status]
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- The decision pathway (the branches of the tree) -----------------------
enum NodeKind {
  DISEASE_TYPE // Prostate, Bladder, Renal
  DISEASE_STATE // mCRPC, localized, metastatic, NMIBC, ...
  LINE_OF_THERAPY // first-line, second-line, ...
  BIOMARKER // e.g. HRR-mutated, PD-L1+
}

model DecisionNode {
  id        String   @id @default(cuid())
  label     String
  kind      NodeKind
  // Self relation builds the tree topology.
  parentId  String?
  parent    DecisionNode?  @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  DecisionNode[] @relation("NodeChildren")
  // Trials hang off the leaf decision nodes.
  trials    Trial[]
  sortOrder Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([kind])
}

// --- Institutions (the SoCal centers) --------------------------------------
model Location {
  id        String          @id @default(cuid())
  slug      String          @unique // "city-of-hope", "ucla", ...
  name      String // "City of Hope"
  shortName String // "COH"
  region    String          @default("Southern California")
  clinicians Clinician[]
  trialLinks TrialLocation[]
  createdAt DateTime        @default(now())
}

// --- Trials (the leaves) ---------------------------------------------------
model Trial {
  id                  String          @id @default(cuid())
  nctId               String?         @unique // NCT01234567
  protocolNumber      String? // e.g. "COH-21345"
  shorthand           String? // human shorthand: "Phase II bladder trial"
  title               String
  phase               String? // "Phase II", "Phase I/II"
  principalInvestigator String?
  eligibilityCriteria String? // free-text, updated via UPDATE_CRITERIA
  // Provenance: CTGOV (synced from ClinicalTrials.gov) or MANUAL.
  source              String   @default("MANUAL")
  lastSyncedAt        DateTime? // last time the CT.gov importer touched this row
  // If a clinician edited criteria via text, the importer stops overwriting it.
  criteriaOverride    Boolean  @default(false)
  // Plain-language summary for patients and caregivers. Every field is
  // optional and summaryApproved starts false, so the curated loader (which
  // deletes and recreates trials and never sets these) keeps working
  // untouched, and nothing renders a summary a human has not signed off on.
  summary             String?
  summarySource       String? // CURATED | AI_GENERATED | CTGOV
  summaryApproved     Boolean  @default(false)
  summaryGeneratedAt  DateTime?
  // Which decision node this trial lives under.
  decisionNodeId      String
  decisionNode        DecisionNode    @relation(fields: [decisionNodeId], references: [id], onDelete: Cascade)
  locations           TrialLocation[]
  cohorts             Cohort[]
  nctMatchCandidates  NctMatchCandidate[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([decisionNodeId])
  @@index([shorthand])
}

enum RecruitmentStatus {
  RECRUITING
  WAITLISTED
  CLOSED
  SUSPENDED
}

// Join row: a trial's recruitment status AT a specific location.
model TrialLocation {
  id         String            @id @default(cuid())
  trialId    String
  trial      Trial             @relation(fields: [trialId], references: [id], onDelete: Cascade)
  locationId String
  location   Location          @relation(fields: [locationId], references: [id], onDelete: Cascade)
  status     RecruitmentStatus @default(RECRUITING)
  piName     String? // site-specific PI may differ from the lead PI
  slotsOpen  Int? // optional accrual slots remaining
  // True once a clinician changes this site's status by text/email. The
  // ClinicalTrials.gov importer will NOT overwrite a row that is overridden,
  // so human edits win and persist across syncs.
  manualOverride Boolean       @default(false)
  source     String            @default("MANUAL") // CTGOV | MANUAL
  lastSyncedAt DateTime?
  updatedAt  DateTime          @updatedAt

  @@unique([trialId, locationId])
  @@index([locationId, status])
}

// Cohorts/arms added to a trial (via ADD_COHORT).
model Cohort {
  id        String            @id @default(cuid())
  trialId   String
  trial     Trial             @relation(fields: [trialId], references: [id], onDelete: Cascade)
  label     String
  status    RecruitmentStatus @default(RECRUITING)
  createdAt DateTime          @default(now())
}

// --- Authorized clinicians (the allowlist for inbound webhooks) ------------
model Clinician {
  id         String    @id @default(cuid())
  name       String
  phone      String?   @unique // E.164, e.g. +13105550123
  email      String?   @unique
  role       String    @default("PI")
  active     Boolean   @default(true)
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([email])
}

// --- Audit log / review queue for every inbound action ---------------------
enum ActionSource {
  SMS
  EMAIL
  ADMIN
}

enum ActionStatus {
  APPLIED // auto-applied (confidence >= threshold)
  PENDING_REVIEW // below threshold, awaiting admin approval
  REJECTED // admin rejected
  FAILED // could not resolve target / DB error
}

model ActionLog {
  id               String       @id @default(cuid())
  source           ActionSource
  sender           String // phone number or email of the clinician
  rawText          String // exactly what they sent
  action           String? // CLOSE_TRIAL, OPEN_TRIAL, ...
  targetIdentifier Json? // { nct_id, protocol_number, shorthand }
  locationGuess    String?
  payload          Json? // { new_status, cohort_label, criteria_text, notes }
  confidence       Int? // 0-100
  reasoning        String?
  status           ActionStatus
  resultMessage    String? // human-readable outcome / error
  resolvedTrialId  String?
  appliedAt        DateTime?
  createdAt        DateTime     @default(now())

  @@index([status])
  @@index([createdAt])
}

// --- Public intake: submissions, suggestions, messages of support ----------
// Everything below arrives from a public web form, so none of it is trusted
// and none of it is published on arrival. Each row lands in a pending state
// and only a human moves it forward.
//
// Three tables rather than one polymorphic "Inbox": the three flows have
// genuinely different workflows (a trial submission gets transcribed into
// curatedData.ts, a suggestion gets triaged, a donor message gets moderated
// onto a public page) and separate tables let each grow columns without
// migrating the others.

enum SubmissionStatus {
  PENDING // straight off the form, untouched
  IN_REVIEW // a curator has picked it up
  APPROVED // accepted — a curator transcribes it into the curated lists
  REJECTED
}

model TrialSubmission {
  id String @id @default(cuid())

  // The trial itself. Only the title is required. A coordinator filling this
  // in from a protocol binder often has no NCT number yet, and rejecting the
  // submission over a missing field loses exactly the trials worth hearing
  // about.
  nctId          String?
  title          String
  protocolNumber String? // institutional protocol / IRB number
  phase          String?
  diseaseArea    String? // free text; a curator maps it onto the decision tree

  // Where it runs. Deliberately free text instead of a Location relation:
  // submissions come from centers we have not onboarded, and a foreign key
  // would reject them at the door.
  institution           String
  institutionSite       String? // department, campus or site detail
  principalInvestigator String?

  // Who sent it. Contact details — every read of this table is a PII read.
  submitterName  String
  submitterEmail String
  submitterPhone String?
  submitterRole  String? // "Principal Investigator", "Study Coordinator", ...

  notes String? // anything else the submitter wants the curator to know

  // Review workflow. The decision, the note and the timestamp are separate
  // columns rather than one status blob so both a future admin dashboard and
  // a future automated NCT-lookup pipeline can read and write this row
  // without a schema rewrite.
  status      SubmissionStatus @default(PENDING)
  reviewNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([status, createdAt])
  @@index([nctId])
}

// --- Lightweight public feedback -------------------------------------------
enum SuggestionKind {
  MISSING_TRIAL
  INCORRECT_INFO
  GENERAL_FEEDBACK
}

enum SuggestionStatus {
  NEW
  TRIAGED
  RESOLVED
  DISMISSED
}

model Suggestion {
  id           String         @id @default(cuid())
  kind         SuggestionKind
  nctId        String?
  message      String
  contactEmail String? // optional: a lot of useful corrections arrive anonymous

  // The trial this is about, held as a bare id and NOT as a relation. The
  // curated loader deletes and recreates every trial on each reload, so a
  // real foreign key with cascade would throw away the very feedback the
  // reload was supposed to act on. A dangling id is the lesser evil.
  relatedTrialId String?

  status    SuggestionStatus @default(NEW)
  createdAt DateTime         @default(now())

  @@index([status, createdAt])
  @@index([relatedTrialId])
}

// --- Messages of support left alongside a donation -------------------------
enum DonorMessageStatus {
  PENDING
  APPROVED
  REJECTED
}

model DonorMessage {
  id          String  @id @default(cuid())
  displayName String
  message     String?

  // Unpublished until a human approves it. There is deliberately no
  // publish-on-arrival path: this text renders on a public page under a
  // person's name, so every public query must filter on status = APPROVED.
  status     DonorMessageStatus @default(PENDING)
  approvedAt DateTime?
  createdAt  DateTime           @default(now())

  @@index([status, createdAt])
}

// --- Proposed ClinicalTrials.gov matches, awaiting a human ------------------
enum NctMatchStatus {
  PROPOSED
  CONFIRMED
  REJECTED
}

model NctMatchCandidate {
  id      String @id @default(cuid())
  trialId String
  trial   Trial  @relation(fields: [trialId], references: [id], onDelete: Cascade)

  // A guess, never a fact. A matcher writes PROPOSED rows; a human confirms
  // them; nothing downstream may treat an unconfirmed row as the trial's real
  // NCT number. Note the cascade: a curated reload drops every trial, and
  // these proposals go with it — which is correct, because the trial ids they
  // point at no longer exist.
  nctId          String
  candidateTitle String
  confidence     Int // 0-100, as scored by the matcher
  evidence       Json? // what actually matched: title tokens, PI, site overlap

  status     NctMatchStatus @default(PROPOSED)
  reviewedAt DateTime?
  createdAt  DateTime       @default(now())

  @@unique([trialId, nctId])
  @@index([status, confidence])
}
